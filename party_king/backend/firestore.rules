rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isVip(userId) {
      return isSignedIn()
        && (request.auth.token.vip == true
          || get(/databases/$(database)/documents/users/$(userId)).data.vipActive == true);
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /userPublic/{userId} {
      allow read: if true;
      allow create: if isSelf(userId) || isAdmin();
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /userStats/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /likes/{likeId} {
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
          || (request.auth.uid == resource.data.toUid && isVip(request.auth.uid))
          || isAdmin());
      allow delete: if isSignedIn() && request.auth.uid == resource.data.fromUid;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false;
      }
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.ownerId || isAdmin());
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && memberId == request.auth.uid;
        allow update: if isSignedIn() && memberId == request.auth.uid;
        allow delete: if isSignedIn()
          && (memberId == request.auth.uid
            || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId
            || isAdmin());
      }
    }

    match /giftCatalog/{giftId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wallets/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /giftTransactions/{txId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
          || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /blocks/{blockId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.blockerUid;
      allow create: if isSignedIn()
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockerUid;
    }

    match /photoReviews/{reviewId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /adminActions/{actionId} {
      allow read, write: if isAdmin();
    }
  }
}
